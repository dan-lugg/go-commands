package commands

import (
	"testing"

	commands2 "github.com/dan-lugg/go-commands/pkg/commands"
)

func Test_Full(t *testing.T) {
	decoderCatalog := NewDefaultDecoderCatalog()
	InsertDecoder[commands2.AddCommandReq](decoderCatalog, NewDefaultDecoder[commands2.AddCommandReq]())
	InsertDecoder[commands2.SubCommandReq](decoderCatalog, NewDefaultDecoder[commands2.SubCommandReq]())

	mappingCatalog := NewDefaultMappingCatalog()
	InsertMapping[commands2.AddCommandReq](mappingCatalog, commands2.AddReqName)
	InsertMapping[commands2.SubCommandReq](mappingCatalog, commands2.SubReqName)

	handlerCatalog := NewDefaultHandlerCatalog()
	InsertHandler[commands2.AddCommandReq, commands2.AddCommandRes](handlerCatalog, func() Handler[commands2.AddCommandReq, commands2.AddCommandRes] {
		return &commands2.AddHandler{}
	})
	InsertHandler[commands2.SubCommandReq, commands2.SubCommandRes](handlerCatalog, func() Handler[commands2.SubCommandReq, commands2.SubCommandRes] {
		return &commands2.SubHandler{}
	})

	reqName := commands2.AddReqName
	reqType, err := mappingCatalog.ByName(reqName)
	if err != nil {
		t.Fatalf("no reqType found for reqName %s: %v", reqName, err)
	}

	req, err := decoderCatalog.Decode(reqType, []byte(`{"argX":3,"argY":4}`))
	if err != nil {
		t.Fatalf("no req found for req name %s: %v", reqType, err)
	}

	res, err := handlerCatalog.Handle(nil, req)
	if err != nil {
		t.Fatalf("handler error for req name %s: %v", reqType, err)
	}

	addRes, ok := res.(commands2.AddCommandRes)
	if !ok {
		t.Fatalf("unexpected response type: %T", res)
	}
	expected := commands2.AddCommandRes{Result: 7}
	if addRes != expected {
		t.Fatalf("unexpected response value: got %v, want %v", addRes, expected)
	}
}
